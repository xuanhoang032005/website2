NODE_ENV=development
PORT=3000
SITE_NAME=AnhTraiStore
SITE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
SESSION_SECRET=replace-with-a-long-random-secret

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=anhtraisstore

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
CONTACT_EMAIL=adminanhtrai@gmail.com

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_PRODUCT_FOLDER=anhtraisstore/products
CLOUDINARY_BANNER_FOLDER=anhtraisstore/banners
CLOUDINARY_AVATAR_FOLDER=anhtraisstore/avatars
CLOUDINARY_CATEGORY_FOLDER=anhtraisstore/categories

# OpenAI GPT / API tương thích OpenAI Chat Completions
# Với key ModelAPI, dùng https://modelapi.vn/v1 cho OPENAI_BASE_URL.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_API_TIMEOUT_MS=60000

# Observability and operations
ALERT_WEBHOOK_URL=
METRICS_TOKEN=
BACKUP_DIR=./backups
JOB_CONCURRENCY=2
