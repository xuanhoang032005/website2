{
  "name": "website",
  "version": "1.0.0",
  "description": "Website thương mại điện tử mô phỏng cho cửa hàng thiết bị công nghệ",
  "private": true,
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "node src/config/migrate.js",
    "lint": "node scripts/lint.js",
    "format": "node scripts/format-check.js",
    "backup": "node scripts/backup.js",
    "test": "node tests/product-regressions.test.js",
    "check": "npm run lint && npm run format && node --check src/config/migrate.js && node tests/product-regressions.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "chart.js": "^4.4.0",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "express-session": "^1.17.3",
    "multer": "^2.2.0",
    "mysql2": "^3.6.5",
    "nodemailer": "^10.0.3",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  },
  "keywords": [
    "website - web development",
    "website - web design",
    "nodejs",
    "express"
  ],
  "author": "Website Team",
  "license": "MIT"
}
